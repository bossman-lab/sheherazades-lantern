<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="{% if description %}{{ description }}{% else %}Blog — {{ site.names[lang] }}{% endif %}">
<title>{% if title %}{{ title }} · {{ site.names[lang] }}{% else %}Blog · {{ site.names[lang] }}{% endif %}</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏮</text></svg>">

{% if site.rss_feeds[lang] %}
<link rel="alternate" type="application/rss+xml" title="{{ site.names[lang] }}" href="{{ site.url }}{{ site.rss_feeds[lang] }}">
{% endif %}

{% for l in site.languages %}
<link rel="alternate" hreflang="{{ l.code }}" href="{{ site.url }}/{% if l.code != 'en' %}{{ l.code }}/{% endif %}">
{% endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}/">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "{{ site.names[lang] }} Blog",
  "url": "{{ site.url }}/blog/",
  "author": { "@type": "Person", "name": "{{ site.authors[lang] }}" }
}
</script>

<!-- === AI / Social Meta === -->
{% set is_article = not ('/blog/index' in page.inputPath or '/blog/' == page.url) %}

<meta property="og:title" content="{% if title %}{{ title }}{% else %}Blog · {{ site.names[lang] }}{% endif %}">
<meta property="og:description" content="{% if description %}{{ description }}{% else %}Blog — {{ site.names[lang] }}{% endif %}">
<meta property="og:type" content="{% if is_article %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/images/cover.webp">
<meta property="og:locale" content="{{ site.locales[lang] | default(lang | replace('-', '_')) }}">
<meta property="og:site_name" content="{{ site.names[lang] }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if title %}{{ title }}{% else %}Blog · {{ site.names[lang] }}{% endif %}">
<meta name="twitter:description" content="{% if description %}{{ description }}{% else %}Blog — {{ site.names[lang] }}{% endif %}">

{% if is_article %}
{% if date %}<meta property="article:published_time" content="{{ date }}">{% endif %}
<meta property="article:author" content="{{ site.authors[lang] }}">
{% if tags %}{% for tag in tags %}<meta property="article:tag" content="{{ tag }}">{% endfor %}{% endif %}
{% endif %}

<!-- === JSON-LD === -->
{% if is_article %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": "{{ title | e }}",
  "description": "{{ description | e }}",
  "author": { "@type": "Person", "name": "{{ site.authors[lang] }}" },
  "datePublished": "{{ date }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ site.url }}{{ page.url }}" },
  "publisher": { "@type": "Organization", "name": "Sheherazade's Lantern" }
}
</script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "{{ site.url }}/blog/" }
    {% if is_article and title %}
    ,{ "@type": "ListItem", "position": 3, "name": "{{ title | e }}", "item": "{{ site.url }}{{ page.url }}" }
    {% endif %}
  ]
}
</script>

<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#000;color:#e8e8ed;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','SF Pro Text','Helvetica Neue','PingFang SC','Noto Naskh Arabic','Geeza Pro',sans-serif;-webkit-font-smoothing:antialiased;line-height:1.7}

/* === NAV === */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;justify-content:center;align-items:center;gap:20px;padding:14px 24px;background:rgba(0,0,0,.8);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px)}
.nav-inner{display:flex;align-items:center;gap:16px;max-width:680px;width:100%;justify-content:flex-end}
nav a{color:#424245;text-decoration:none;font-size:13px;font-weight:500;transition:color .3s}
nav a:hover{color:#d4a747}
nav .active{color:#d4a747}
nav .divider{color:#2a2a2a;font-size:11px}

/* === ARTICLE === */
.article{max-width:680px;margin:0 auto;padding:100px 24px 40px}
.article h1{font-size:36px;font-weight:700;line-height:1.2;margin-bottom:16px;letter-spacing:-.5px;color:#f5f5f7}
.article h2{font-size:24px;font-weight:600;margin:40px 0 12px;color:#f5f5f7;letter-spacing:-.2px}
.article h3{font-size:19px;font-weight:600;margin:28px 0 8px;color:#f5f5f7}
.article p{line-height:1.8;margin:0 0 20px;color:#c8c8cd}
.article a{color:#d4a747;text-decoration:none;transition:color .3s}
.article a:hover{color:#e8c05e}
.article ul,.article ol{line-height:1.8;margin:0 0 20px;padding-left:24px;color:#c8c8cd}
.article li{margin-bottom:6px}
.article blockquote{border-left:2px solid rgba(212,167,71,.3);margin:28px 0;padding:12px 24px;color:#a0a0a8;font-style:italic;background:rgba(212,167,71,.02);border-radius:0 6px 6px 0}
.article blockquote p{margin:0;color:#a0a0a8}
.article code{font-family:'SF Mono','Menlo','Consolas',monospace;font-size:14px;background:rgba(212,167,71,.06);padding:2px 8px;border-radius:4px;color:#e0d8c8}
.article pre{background:rgba(255,255,255,.03);border:1px solid rgba(212,167,71,.08);border-radius:8px;padding:16px 20px;margin:0 0 20px;overflow-x:auto}
.article pre code{background:none;padding:0;font-size:13px;line-height:1.6;color:#c0c0c8}
.article hr{border:none;border-top:1px solid rgba(212,167,71,.08);margin:40px 0}
.article table{width:100%;border-collapse:collapse;margin:24px 0;font-size:14px}
.article th,.article td{border:1px solid rgba(212,167,71,.1);padding:10px 14px;text-align:left}
.article th{background:rgba(212,167,71,.04);color:#d4a747;font-weight:500;font-size:12px;text-transform:uppercase;letter-spacing:.5px}
.article td{color:#c8c8cd}
.article img{max-width:100%;border-radius:8px;margin:24px 0}

/* === BLOG LIST === */
.blog-list{max-width:640px;margin:0 auto;padding:100px 24px 40px}
.blog-list h1{font-size:32px;font-weight:700;letter-spacing:-.5px;margin-bottom:6px;color:#f5f5f7}
.blog-list .subtitle{color:#68686b;font-size:16px;margin-bottom:40px;line-height:1.5}
.blog-post{padding:24px 0;border-bottom:1px solid rgba(212,167,71,.06)}
.blog-post:first-of-type{border-top:1px solid rgba(212,167,71,.06)}
.blog-post .date{font-size:12px;color:#424245;margin-bottom:6px}
.blog-post a{text-decoration:none;color:#f5f5f7;font-size:19px;font-weight:500;display:block;margin-bottom:6px;line-height:1.3;transition:color .3s}
.blog-post a:hover{color:#d4a747}
.blog-post .desc{color:#68686b;font-size:14px;line-height:1.6;margin:0}
.back-link{margin-top:40px;padding-top:24px}
.back-link a{color:#424245;text-decoration:none;font-size:13px;transition:color .3s}
.back-link a:hover{color:#d4a747}

/* === FOOTER === */
footer{text-align:center;padding:0 24px 48px;color:#2a2a2a;font-size:12px;line-height:1.8}

@media(max-width:640px){
  nav{padding:12px 16px}
  .article{padding:80px 20px 30px;font-size:16px}
  .article h1{font-size:26px}
  .article h2{font-size:20px}
  .blog-list{padding:80px 20px 30px}
  .blog-list h1{font-size:26px}
  .blog-post a{font-size:17px}
}
</style>
</head>
<body>

<nav>
  <div class="nav-inner">
    <a href="{{ site.url }}/">Podcast</a>
    <a href="{{ site.url }}/blog/" class="active">Blog</a>
    <span class="divider">/</span>
    {%- for l in site.languages %}
    {% if l.code != lang %}<a href="{{ site.url }}/{% if l.code != 'en' %}{{ l.code }}/{% endif %}">{{ l.label }}</a>{% else %}<a href="#" class="active">{{ l.label }}</a>{% endif %}
    {% if not loop.last %}<span class="divider">/</span>{% endif %}
    {%- endfor %}
  </div>
</nav>

{% if '/blog/index' in page.inputPath or '/blog/' == page.url %}
<div class="blog-list">
{{ content | safe }}
</div>
{% else %}
<div class="article">
{{ content | safe }}

<div style="margin-top:48px;padding-top:24px;border-top:1px solid rgba(212,167,71,.06)">
  <a href="{{ site.url }}/blog/" style="color:#424245;text-decoration:none;font-size:13px;">← Back to Blog</a>
</div>
</div>
{% endif %}

<footer>
  {% for line in site.footer[lang] %}
  <p>{{ line }}</p>
  {% endfor %}
</footer>

</body>
</html>
