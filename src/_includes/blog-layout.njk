<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="{% if description %}{{ description }}{% else %}Blog — Sheherazade's Lantern{% endif %}">
<title>{% if title %}{{ title }} · {{ site.names[lang] }}{% else %}Blog · {{ site.names[lang] }}{% endif %}</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏮</text></svg>">

{% if site.rss_feeds[lang] %}
<link rel="alternate" type="application/rss+xml" title="{{ site.names[lang] }}" href="{{ site.url }}{{ site.rss_feeds[lang] }}">
{% endif %}

{% for l in site.languages %}
<link rel="alternate" hreflang="{{ l.code }}" href="{{ site.url }}/{% if l.code != 'en' %}{{ l.code }}/{% endif %}">
{% endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}/">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "{{ site.names[lang] }} Blog",
  "url": "{{ site.url }}/blog/",
  "author": { "@type": "Person", "name": "{{ site.authors[lang] }}" }
}
</script>

<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#000;color:#e8e8ed;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','SF Pro Text','Helvetica Neue',sans-serif;-webkit-font-smoothing:antialiased;line-height:1.7;font-size:17px}
nav{display:flex;justify-content:flex-end;align-items:center;padding:20px 24px;gap:12px}
nav a{color:#424245;text-decoration:none;font-size:13px;transition:color .2s}
nav a:hover{color:#f5f5f7}
nav span{color:#424245;font-size:11px}

.article{max-width:680px;margin:0 auto;padding:60px 24px 40px}
.article h1{font-size:38px;font-weight:700;line-height:1.2;margin-bottom:16px;letter-spacing:-.5px;color:#f5f5f7}
.article h2{font-size:26px;font-weight:600;margin:40px 0 12px;color:#f5f5f7;letter-spacing:-.2px}
.article h3{font-size:20px;font-weight:600;margin:28px 0 8px;color:#f5f5f7}
.article p{line-height:1.8;margin:0 0 20px;color:#d8d8dd}
.article a{color:#5e9eff;text-decoration:none}
.article a:hover{text-decoration:underline}
.article ul,.article ol{line-height:1.8;margin:0 0 20px;padding-left:24px;color:#d8d8dd}
.article li{margin-bottom:6px}
.article blockquote{border-left:3px solid #333;margin:24px 0;padding:12px 20px;color:#a0a0a8;font-style:italic;background:rgba(255,255,255,.02);border-radius:0 4px 4px 0}
.article blockquote p{margin:0;color:#a0a0a8}
.article code{font-family:'SF Mono','Menlo','Consolas',monospace;font-size:14px;background:rgba(255,255,255,.06);padding:2px 8px;border-radius:4px;color:#e8e8ed}
.article pre{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:16px 20px;margin:0 0 20px;overflow-x:auto}
.article pre code{background:none;padding:0;font-size:13px;line-height:1.6;color:#ccc}
.article hr{border:none;border-top:1px solid rgba(255,255,255,.08);margin:40px 0}
.article table{width:100%;border-collapse:collapse;margin:24px 0;font-size:15px}
.article th,.article td{border:1px solid rgba(255,255,255,.08);padding:10px 14px;text-align:left}
.article th{background:rgba(255,255,255,.04);color:#a0a0a8;font-weight:500;font-size:13px;text-transform:uppercase;letter-spacing:.5px}
.article td{color:#d8d8dd}
.article img{max-width:100%;border-radius:8px;margin:24px 0}
.article blockquote em{color:#7a7a80}

.footer{text-align:center;padding:40px 24px 60px;color:#424245;font-size:13px;line-height:1.6}

@media(max-width:640px){
  .article{padding:40px 20px 30px}
  .article h1{font-size:28px}
  .article h2{font-size:22px}
  .article{font-size:16px}
}
</style>
</head>
<body>

<nav>
  <a href="{{ site.url }}/">Podcast</a>
  <a href="{{ site.url }}/blog/" style="color:#f5f5f7">Blog</a>
  <span>/</span>
  {%- for l in site.languages %}
  {% if l.code != lang %}<a href="{{ site.url }}/{% if l.code != 'en' %}{{ l.code }}/{% endif %}">{{ l.label }}</a>{% else %}<a href="#">{{ l.label }}</a>{% endif %}
  {% if not loop.last %}<span>/</span>{% endif %}
  {%- endfor %}
</nav>

<div class="article">
{{ content | safe }}
</div>

<div class="footer">
  {% for line in site.footer[lang] %}
  {{ line }}<br>
  {% endfor %}
</div>

</body>
</html>
