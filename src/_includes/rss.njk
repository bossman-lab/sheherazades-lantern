<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
  xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd"
  xmlns:content="http://purl.org/rss/1.0/modules/content/"
  xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ site.names[lang] }}</title>
  <description>{{ site.descriptions[lang] }}</description>
  <link>{{ site.url }}/{{ lang_prefix }}</link>
  <language>{{ site.locales[lang] }}</language>
  <image>
    <url>{{ site.url }}{{ site.cover }}</url>
    <title>{{ site.names[lang] }}</title>
    <link>{{ site.url }}/{{ lang_prefix }}</link>
  </image>
  <itunes:author>{{ site.authors[lang] }}</itunes:author>
  <itunes:summary>{{ site.taglines[lang] }}</itunes:summary>
  <itunes:image href="{{ site.url }}{{ site.cover }}"/>
  <itunes:explicit>{{ site.explicit }}</itunes:explicit>
  <itunes:type>{{ site.itunes_type }}</itunes:type>
  <itunes:category text="{{ site.category }}">
    <itunes:category text="{{ site.subcategory }}"/>
  </itunes:category>
  <itunes:owner>
    <itunes:name>{{ site.owner_name }}</itunes:name>
    <itunes:email>{{ site.owner_email }}</itunes:email>
  </itunes:owner>
  <lastBuildDate>{{ site.lastmod }}</lastBuildDate>
  <atom:link href="{% if lang_prefix %}{{ site.url }}/{{ lang_prefix }}/podcast.xml{% else %}{{ site.url }}/podcast/podcast.xml{% endif %}" rel="self" type="application/rss+xml"/>

  {%- for ep in episodes %}{% if ep.published %}
  <item>
    <title>{{ ep.titles[lang] }}</title>
    <description>{{ ep.descriptions[lang] }}</description>
    <enclosure url="{{ site.url }}{{ ep.audio[lang] }}" type="audio/mpeg" length="{{ ep.filesize[lang] }}"/>
    <guid isPermaLink="false">{{ site.url }}-{{ lang }}-ep{{ ep.id }}</guid>
    <pubDate>{{ ep.pubDate | dateRfc822 }}</pubDate>
    <itunes:duration>{{ ep.duration }}</itunes:duration>
    <itunes:episode>{{ ep.id | int }}</itunes:episode>
  </item>
  {% endif %}{%- endfor %}
</channel>
</rss>
