<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if title %}{{ title }}{% else %}{{ site.names[lang] }}{% endif %}</title>
<meta name="description" content="{{ site.descriptions[lang] }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  "name": "{{ site.names[lang] }}",
  "description": "{{ site.descriptions[lang] }}",
  "url": "{{ site.url }}/{{ lang_prefix }}",
  "image": "{{ site.url }}{{ site.cover }}",
  "inLanguage": "{{ lang }}",
  "author": { "@type": "Person", "name": "{{ site.authors[lang] }}" },
  "episode": [
    {%- for ep in episodes %}
    {"@type":"PodcastEpisode","position":{{ loop.index }},"name":"{{ ep.titles[lang] | e }}","url":"{{ site.url }}/{{ lang_prefix }}episodes/{{ ep.id }}"}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{% for l in site.languages -%}
{% if l.code != lang %}<link rel="alternate" hreflang="{{ l.code }}" href="{{ site.url }}/{% if l.code != 'en' %}{{ l.code }}/{% endif %}">{% endif %}
{% endfor -%}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
{% if dir == "rtl" %}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;700&display=swap">
{% endif %}
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{
  background:#000;
  color:#f5f5f7;
  font-family:{% if dir == "rtl" %}'Noto Naskh Arabic','Geeza Pro',{% endif %}-apple-system,BlinkMacSystemFont,'SF Pro Display','SF Pro Text','Helvetica Neue',{% if lang == "cn" %}'PingFang SC',{% endif %}sans-serif;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  line-height:{{ "1.8" if dir == "rtl" else "1.5" }}
}
.container{max-width:680px;margin:0 auto;padding:0 24px}
nav{display:flex;justify-content:{{ "flex-start" if dir == "rtl" else "flex-end" }};align-items:center;padding:20px 24px;gap:12px}
nav a{color:#424245;text-decoration:none;font-size:13px;transition:color .2s}
nav a:hover{color:#f5f5f7}
nav span{color:#424245;font-size:11px}
.lang-active{color:#f5f5f7!important}
.hero{text-align:center;padding:80px 0 0}
.hero img{width:280px;height:280px;border-radius:16px;box-shadow:0 24px 80px rgba(255,215,0,.08)}
h1{
  font-size:{{ "42px" if dir == "rtl" else ("40px" if lang == "cn" else "44px") }};
  font-weight:{{ "700" if dir == "rtl" else "600" }};
  letter-spacing:{{ "-.3px" if lang == "cn" else "-.5px" }};
  margin:40px 0 12px;
  color:#f5f5f7;
  line-height:1.3
}
.tagline{
  font-size:{{ "18px" if dir == "rtl" else ("17px" if lang == "cn" else "18px") }};
  font-weight:400;
  color:#86868b;
  max-width:520px;
  margin:0 auto;
  line-height:{{ "1.8" if dir == "rtl" else "1.7" }}
}
.episodes{padding:80px 0 60px}
.ep-label{
  font-size:11px;
  font-weight:600;
  letter-spacing:1.5px;
  text-transform:uppercase;
  color:#424245;
  margin-bottom:36px
}
.episode{padding:32px 0;border-top:1px solid rgba(255,255,255,.06)}
.episode:last-child{border-bottom:1px solid rgba(255,255,255,.06)}
.ep-number{
  font-size:11px;
  font-weight:600;
  letter-spacing:1.2px;
  text-transform:uppercase;
  color:#ffd700;
  margin-bottom:6px
}
.ep-title{
  font-size:22px;
  font-weight:{{ "700" if dir == "rtl" else "600" }};
  letter-spacing:-.2px;
  color:#f5f5f7;
  margin-bottom:8px
}
.ep-desc{
  font-size:15px;
  color:#86868b;
  line-height:{{ "1.8" if dir == "rtl" else "1.75" }};
  margin-bottom:6px
}
.ep-chars{font-size:13px;color:#424245;margin-bottom:14px}
audio{width:100%;height:36px;border-radius:6px;filter:invert(1);opacity:.7}
audio::-webkit-media-controls-panel{background:#1a1a1a}
.donate{text-align:center;padding:40px 0 20px;border-top:1px solid rgba(255,255,255,.06)}
.donate p{font-size:13px;color:#424245;line-height:1.8}
.donate code{font-size:12px;color:#86868b;word-break:break-all{% if dir == "rtl" %};direction:ltr;display:inline-block{% endif %}}
.donate strong{color:#86868b}
.rss{text-align:center;padding:24px 0 60px}
.rss a{
  display:inline-flex;align-items:center;gap:8px;
  font-size:13px;font-weight:500;
  color:#ffd700;text-decoration:none;
  padding:8px 20px;
  border:1px solid rgba(255,215,0,.2);
  border-radius:20px;
  transition:border-color .2s,background .2s
}
.rss a:hover{border-color:rgba(255,215,0,.4);background:rgba(255,215,0,.04)}
footer{text-align:center;padding:24px 0 48px}
footer p{font-size:12px;color:#424245;line-height:1.8}
@media(max-width:480px){
  .hero{padding:60px 0 0}
  .hero img{width:200px;height:200px}
  h1{font-size:30px;margin:32px 0 10px}
  .tagline{font-size:{% if lang == "cn" %}15px{% else %}16px{% endif %}}
  .episodes{padding:60px 0 40px}
  .ep-title{font-size:19px}
}
</style>
</head>
<body>

<nav>
  {%- for l in site.languages %}
  {% if l.code != lang %}<a href="{% if lang_prefix %}{% if l.code == 'en' %}../{% else %}../{{ l.code }}/{% endif %}{% else %}{% if l.code == 'en' %}/{% else %}{{ l.code }}/{% endif %}{% endif %}">{{ l.label }}</a>{% else %}<a href="#" class="lang-active">{{ l.label }}</a>{% endif %}
  {% if not loop.last %}<span>/</span>{% endif %}
  {%- endfor %}
</nav>

<div class="hero">
  <img src="{% if lang_prefix %}{{ '../' + site.cover }}{% else %}{{ site.cover }}{% endif %}" alt="{{ site.names[lang] }}">
  <h1>{{ site.names[lang] }}</h1>
  <p class="tagline">{{ site.taglines[lang] }}</p>
</div>

<div class="container">
<div class="episodes">
  <div class="ep-label">{{ site.episode_labels[lang] }}</div>

  {%- for ep in episodes %}
  <div class="episode">
    <div class="ep-number">{% if lang == "cn" %}第 {{ loop.index | pad(2, "0") }} 集{% elif lang == "ar" %}الحلقة {{ loop.index }}{% else %}Episode {{ loop.index | pad(2, "0") }}{% endif %}</div>
    <div class="ep-title">{{ ep.titles[lang] }}</div>
    <div class="ep-desc">{{ ep.descriptions[lang] }}</div>
    <div class="ep-chars">{{ ep.chars[lang] }}</div>
    <audio controls preload="none"><source src="{% if lang_prefix %}..{{ ep.audio[lang] }}{% else %}{{ ep.audio[lang] }}{% endif %}" type="audio/mpeg"></audio>
  </div>
  {%- endfor %}
</div>

<div class="donate">
  <p>☕ <strong>{{ site.donate_labels[lang] }}</strong> — <code>{{ site.donate }}</code><br>USDT (TRC-20)</p>
</div>

{% if lang == "en" %}
<div class="rss">
  <a href="{{ site.rss_feeds[lang] }}">📡 RSS Feed</a>
</div>
{% else %}
<div class="rss">
  <a href="{% if lang_prefix %}..{{ site.rss_feeds[lang] }}{% else %}{{ site.rss_feeds[lang] }}{% endif %}">📡 RSS Feed</a>
</div>
{% endif %}

<footer>
  <p>{{ site.footer[lang][0] }}</p>
  <p>{{ site.footer[lang][1] }}</p>
</footer>
</div>

</body>
</html>
