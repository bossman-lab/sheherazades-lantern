<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="{{ site.descriptions[lang] }}">
<title>{{ site.names[lang] }}</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏮</text></svg>">

{% for l in site.languages %}
<link rel="alternate" hreflang="{{ l.code }}" href="{{ site.url }}/{% if l.code != 'en' %}{{ l.code }}/{% endif %}">
{% endfor %}
<link rel="alternate" hreflang="x-default" href="{{ site.url }}/">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  "name": "{{ site.names[lang] }}",
  "description": "{{ site.descriptions[lang] }}",
  "url": "{{ site.url }}/{{ lang_prefix }}",
  "image": "{{ site.url }}{{ site.cover }}",
  "inLanguage": "{{ lang }}",
  "author": { "@type": "Person", "name": "{{ site.authors[lang] }}" },
  "episode": [
    {%- for ep in episodes %}{% if ep.published %}
    {"@type":"PodcastEpisode","position":{{ ep.id | int }},"name":"{{ ep.titles[lang] | json_str | safe }}","url":"{{ site.url }}/{{ lang_prefix }}episodes/{{ ep.id }}"}{% if not loop.last %},{% endif %}
    {% endif %}{%- endfor %}
  ]
}
</script>

<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#000;color:#e8e8ed;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','SF Pro Text','Helvetica Neue','PingFang SC','Noto Naskh Arabic','Geeza Pro',sans-serif;-webkit-font-smoothing:antialiased;line-height:1.6}

/* === NAV === */
nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;justify-content:center;align-items:center;gap:20px;padding:14px 24px;background:rgba(0,0,0,.8);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px)}
.nav-inner{display:flex;align-items:center;gap:16px;max-width:680px;width:100%;justify-content:flex-end}
nav a{color:#424245;text-decoration:none;font-size:13px;font-weight:500;transition:color .3s}
nav a:hover{color:#d4a747}
nav .active{color:#d4a747}
nav .divider{color:#2a2a2a;font-size:11px}

/* === HERO === */
.hero{text-align:center;padding:120px 24px 60px;position:relative}
.hero img{width:320px;height:320px;border-radius:16px;box-shadow:0 24px 80px rgba(212,167,71,.06);margin-bottom:36px;transition:transform .4s ease}
.hero img:hover{transform:scale(1.02)}
.hero h1{font-size:42px;font-weight:600;letter-spacing:-.5px;margin-bottom:10px;color:#f5f5f7;line-height:1.2}
.hero .tagline{font-size:17px;color:#68686b;max-width:500px;margin:0 auto;line-height:1.7}
.hero .tagline em{color:#d4a747;font-style:normal}

/* === EPISODES === */
.episodes{max-width:640px;margin:0 auto;padding:40px 24px 60px}
.ep-label{font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:#2a2a2a;margin-bottom:28px}
.episode{padding:28px 20px;border:1px solid rgba(212,167,71,.06);border-radius:10px;margin-bottom:16px;transition:border-color .3s,background .3s}
.episode:hover{border-color:rgba(212,167,71,.15);background:rgba(212,167,71,.02)}
.ep-number{font-size:11px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:#d4a747;margin-bottom:6px}
.ep-title{font-size:20px;font-weight:600;color:#f5f5f7;margin-bottom:6px;line-height:1.3}
.ep-desc{font-size:14px;color:#68686b;line-height:1.7;margin-bottom:4px}
.ep-chars{font-size:12px;color:#424245;margin-bottom:12px}
audio{width:100%;height:36px;border-radius:6px;filter:invert(1);opacity:.65}
audio::-webkit-media-controls-panel{background:#1a1a1a}

/* === DONATE === */
.donate{text-align:center;padding:48px 24px 0}
.donate-inner{max-width:400px;margin:0 auto;border:1px solid rgba(212,167,71,.06);border-radius:10px;padding:24px}
.donate p{font-size:13px;color:#424245;line-height:1.8}
.donate code{font-size:11px;color:#68686b;word-break:break-all;background:rgba(255,255,255,.03);padding:4px 8px;border-radius:4px}
.donate strong{color:#68686b}

/* === RSS === */
.rss{text-align:center;padding:32px 24px 80px}
.rss a{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:500;color:#d4a747;text-decoration:none;padding:8px 20px;border:1px solid rgba(212,167,71,.2);border-radius:20px;transition:border-color .3s,background .3s}
.rss a:hover{border-color:rgba(212,167,71,.4);background:rgba(212,167,71,.04)}

/* === FOOTER === */
footer{text-align:center;padding:0 24px 48px}
footer p{font-size:12px;color:#2a2a2a;line-height:1.8}

/* === RESPONSIVE === */
@media(max-width:640px){
  nav{padding:12px 16px;gap:14px}
  .hero{padding:100px 20px 40px}
  .hero img{width:220px;height:220px}
  .hero h1{font-size:30px}
  .hero .tagline{font-size:15px}
  .episodes{padding:24px 16px 40px}
  .episode{padding:20px 16px}
  .ep-title{font-size:18px}
  .donate-inner{padding:16px}
}
</style>
</head>
<body>

<nav>
  <div class="nav-inner">
    <a href="{{ site.url }}/" class="{% if lang_prefix == '' %}active{% endif %}">Podcast</a>
    <a href="{{ site.url }}/blog/" class="{% if page.url and '/blog' in page.url %}active{% endif %}">Blog</a>
    <span class="divider">/</span>
    {%- for l in site.languages %}
    {% if l.code != lang %}<a href="{{ site.url }}/{% if l.code != 'en' %}{{ l.code }}/{% endif %}">{{ l.label }}</a>{% else %}<a href="#" class="active">{{ l.label }}</a>{% endif %}
    {% if not loop.last %}<span class="divider">/</span>{% endif %}
    {%- endfor %}
  </div>
</nav>

<div class="hero">
  <img src="{{ site.url }}{{ site.cover }}" alt="{{ site.names[lang] }}">
  <h1>{{ site.names[lang] }}</h1>
  <p class="tagline">{{ site.taglines[lang] }}</p>
</div>

<div class="episodes">
  <div class="ep-label">{{ site.episode_labels[lang] }}</div>
  {%- for ep in episodes %}{% if ep.published %}
  <div class="episode">
    <div class="ep-number">Episode {{ ep.id | int }}</div>
    <div class="ep-title">{{ ep.titles[lang] }}</div>
    <div class="ep-desc">{{ ep.descriptions[lang] }}</div>
    <div class="ep-chars">{{ ep.chars[lang] }}</div>
    <audio controls preload="none"><source src="{{ site.url }}{{ ep.audio[lang] }}" type="audio/mpeg"></audio>
  </div>
  {% endif %}{%- endfor %}
</div>

<div class="donate">
  <div class="donate-inner">
    <p>🏮 <strong>Keep the Lantern Burning</strong><br>
    <code>{{ site.donate }}</code><br>
    USDT (TRC-20)</p>
  </div>
</div>

<div class="rss">
  <a href="{{ site.url }}{{ site.rss_feeds[lang] }}">📡 RSS Feed</a>
</div>

<footer>
  {% for line in site.footer[lang] %}
  <p>{{ line }}</p>
  {% endfor %}
</footer>

</body>
</html>
